# Google OAuth 2.0 Web client ID (Google Cloud Console > APIs & Services > Credentials).
# Add every origin the app is served from to "Authorized JavaScript origins",
# e.g. http://localhost:3000 and https://pairwise.example.com.
GOOGLE_CLIENT_ID=
# Optional comma-separated list of Google account emails allowed to sign in. Empty = anyone.
ALLOWED_EMAILS=
PORT=3000
# Extra browser origins allowed to call the API (comma-separated), e.g. a tunnel hostname.
PUBLIC_ORIGIN=
OPENAI_BACKEND_MODEL=gpt-5.6-terra
OPENAI_CONTEXT_MODEL=gpt-5.6-luna
# Optional: secret for encrypting stored OpenAI keys. Generated into data/.secret when unset.
PAIRWISE_SECRET=
# Development only (ignored in production): sign every request in as this address without
# Google, and let that user fall back to OPENAI_API_KEY when no key is saved on the profile.
DEV_USER_EMAIL=
OPENAI_API_KEY=
